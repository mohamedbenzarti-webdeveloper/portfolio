# Formspree form ID for the contact form (the part after /f/ in your form endpoint).
# Example: endpoint https://formspree.io/f/xyzabcd  ->  FORMSPREE_FORM_ID=xyzabcd
# Leave empty in development: submissions are printed to the terminal instead.
FORMSPREE_FORM_ID=

# Public URL of the site (canonical links, sitemap, social previews), no trailing slash.
# Optional on Vercel (its production domain is used automatically); set it for a custom domain.
NEXT_PUBLIC_SITE_URL=
